{
  "name": "algolab",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based p5.js instrument for live-coding audio-reactive visuals",
  "keywords": [
    "live-coding",
    "creative-coding",
    "p5js",
    "audio-reactive",
    "visuals",
    "algorave"
  ],
  "author": "Eric Freeman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erictfree/AlgoLab.git"
  },
  "type": "module",
  "scripts": {
    "build:patches": "node scripts/build-patch-library.mjs",
    "predev": "npm run build:patches",
    "dev": "node scripts/dev-server.mjs",
    "pretest": "npm run build:patches",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:soak": "playwright test --config playwright.soak.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
