{
  "name": "algolab",
  "version": "0.1.0",
  "private": true,
  "description": "AlgoLab — a p5.js live visual playground for audio-reactive performance (AET 350C)",
  "type": "module",
  "scripts": {
    "build:patches": "node scripts/build-patch-library.mjs",
    "predev": "npm run build:patches",
    "dev": "node scripts/dev-server.mjs",
    "pretest": "npm run build:patches",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:soak": "playwright test --config playwright.soak.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "vitest": "^2.1.0"
  }
}
